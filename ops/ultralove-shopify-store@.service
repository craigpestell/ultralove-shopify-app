[Unit]
Description=UltraLove Catalog interface for the %i store app
After=network.target

[Service]
Type=simple
User=ultralove-shopify
Group=ultralove-shopify
WorkingDirectory=/srv/ultralove-shopify/current
Environment=NODE_ENV=production
Environment=PATH=/opt/ultralove-node/bin:/usr/bin:/bin
EnvironmentFile=/etc/ultralove-shopify/stores/%i.env
ExecStart=/opt/ultralove-node/bin/node server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ultralove-shopify-stores/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
