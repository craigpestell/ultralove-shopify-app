{%- comment -%}
  Stock text for one variant: "N in stock" or "Out of stock" ("In stock" when inventory is not tracked).
  Usage: {% render 'ultralove-stock', variant: variant %}
{%- endcomment -%}
{%- if variant.inventory_management == blank and variant.available -%}
  In stock
{%- elsif variant.inventory_quantity > 0 -%}
  {{ variant.inventory_quantity }} in stock
{%- else -%}
  Out of stock
{%- endif -%}
