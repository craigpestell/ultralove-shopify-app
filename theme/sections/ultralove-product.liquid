{%- comment -%}
  Product detail for the lab storefront, used by templates/product.ultralove.json
  (/products/<handle>?view=ultralove). The gallery has a main image with arrows and
  swipe, a thumbnail strip, and an enlarge dialog. One select per option picks the
  variant; the price, SKU, stock, add-to-cart state and gallery image follow the
  selected variant. Products with only the default variant show no picker. "Stock checked" is
  the time of the app's last verified sync, from the metafield ultralove.inventory_checked_at.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ul-product-form-' | append: section.id
-%}
<div class="section page-width-normal">
<div class="ul-product" data-ul-product>
  {%- liquid
    assign images = product.media | where: 'preview_image'
    assign start_media = current.featured_media | default: product.featured_media
  -%}
  <div class="ul-gallery" data-ul-gallery>
    <div class="ul-gallery__stage">
      <ul class="ul-gallery__slides" role="list" data-ul-slides>
        {%- for media in images -%}
          {%- liquid
            assign loading = 'lazy'
            if media.id == start_media.id
              assign loading = 'eager'
            endif
          -%}
          <li class="ul-gallery__slide" data-media-id="{{ media.id }}" data-zoom="{{ media.preview_image | image_url: width: 2048 }}">
            {{ media.preview_image | image_url: width: 1024 | image_tag: loading: loading, sizes: '(min-width: 990px) 50vw, 100vw', alt: media.alt | default: product.title | escape }}
          </li>
        {%- else -%}
          <li class="ul-gallery__slide">{{ 'product-1' | placeholder_svg_tag }}</li>
        {%- endfor -%}
      </ul>
      {%- if images.size > 1 -%}
        <button type="button" class="ul-gallery__arrow ul-gallery__arrow--prev" data-ul-step="-1" aria-label="Previous image">&#8249;</button>
        <button type="button" class="ul-gallery__arrow ul-gallery__arrow--next" data-ul-step="1" aria-label="Next image">&#8250;</button>
      {%- endif -%}
      {%- if images.size > 0 -%}
        <button type="button" class="ul-gallery__zoom-button" data-ul-zoom-open aria-label="Enlarge image">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15 15l7 7" stroke="currentColor" stroke-width="2"/></svg>
        </button>
      {%- endif -%}
    </div>

    {%- if images.size > 1 -%}
      <ul class="ul-gallery__thumbs" role="list">
        {%- for media in images -%}
          <li>
            <button type="button" class="ul-gallery__thumb" data-ul-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }} of {{ images.size }}">
              {{ media.preview_image | image_url: width: 128 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <dialog class="ul-gallery__dialog" data-ul-zoom>
      <form method="dialog"><button class="ul-gallery__close" aria-label="Close">&times;</button></form>
      <img alt="" data-ul-zoom-image>
    </dialog>
  </div>

  <div class="ul-product__info">
    <h1 class="ul-product__title">{{ product.title | escape }}</h1>
    {%- if product.vendor != blank -%}<p class="ul-product__vendor">{{ product.vendor | escape }}</p>{%- endif -%}

    <p class="ul-product__price">
      <span data-ul-price>{{ current.price | money }}</span>
      <s data-ul-compare{% unless current.compare_at_price > current.price %} hidden{% endunless %}>{{ current.compare_at_price | money }}</s>
    </p>

    {%- form 'product', product, id: form_id, class: 'ul-product__form' -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-ul-variant-id>

      {%- unless product.has_only_default_variant -%}
        <div class="ul-product__options">
          {%- for option in product.options_with_values -%}
            <label class="ul-field">
              <span class="ul-field__label">{{ option.name | escape }}</span>
              <select data-ul-option="{{ forloop.index0 }}">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value | escape }}</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      <dl class="ul-product__facts">
        <div><dt>SKU</dt><dd data-ul-sku>{{ current.sku | default: '—' | escape }}</dd></div>
        <div><dt>Stock</dt><dd data-ul-stock>{% render 'ultralove-stock', variant: current %}</dd></div>
        {%- assign checked_at = product.metafields.ultralove.inventory_checked_at.value -%}
        {%- if checked_at -%}
          <div><dt>Stock checked</dt><dd>{{ checked_at | date: '%b %-d, %Y at %-I:%M %p %Z' }}</dd></div>
        {%- endif -%}
      </dl>

      <div class="ul-product__buy">
        <label class="ul-field ul-field--qty">
          <span class="ul-field__label">Quantity</span>
          <input type="number" name="quantity" value="1" min="1">
        </label>
        <button type="submit" class="button" data-ul-submit{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
        </button>
      </div>
    {%- endform -%}

    {%- unless product.has_only_default_variant -%}
      <details class="ul-product__variants">
        <summary>All {{ product.variants.size }} variants</summary>
        <table>
          <thead><tr><th>Variant</th><th>SKU</th><th>Price</th><th>Stock</th></tr></thead>
          <tbody>
            {%- for variant in product.variants -%}
              <tr>
                <td>{{ variant.title | escape }}</td>
                <td>{{ variant.sku | default: '—' | escape }}</td>
                <td>{{ variant.price | money }}</td>
                <td>{% render 'ultralove-stock', variant: variant %}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </details>
    {%- endunless -%}

    {%- if product.description != blank -%}
      <div class="ul-product__description rte">{{ product.description }}</div>
    {%- endif -%}
  </div>

  {%- comment -%} Variant data for the picker: stock text is rendered here so the script needs no copy of its rules. {%- endcomment -%}
  <script type="application/json" data-ul-variants>
    [
      {%- for variant in product.variants -%}
        {%- capture stock %}{% render 'ultralove-stock', variant: variant %}{% endcapture -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "sku": {{ variant.sku | default: '—' | json }},
          "stock": {{ stock | strip | json }},
          "media": {{ variant.featured_media.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>
</div>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling.querySelector('[data-ul-product]');
    const variants = JSON.parse(root.querySelector('[data-ul-variants]').textContent);
    const field = (name) => root.querySelector(`[data-ul-${name}]`);

    const track = field('slides');
    const slides = [...track.children];
    const thumbs = [...root.querySelectorAll('[data-ul-thumb]')];
    const strip = thumbs[0]?.closest('ul');
    const dialog = field('zoom');
    let active = 0;
    const markActive = (index) => {
      active = index;
      thumbs.forEach((thumb, i) => thumb.setAttribute('aria-current', i === index));
      const item = thumbs[index]?.parentElement;
      if (item) strip.scrollTo({ top: item.offsetTop - (strip.clientHeight - item.offsetHeight) / 2, left: item.offsetLeft - (strip.clientWidth - item.offsetWidth) / 2 });
    };
    // While a programmatic scroll runs, the scroll listener waits for it to land on `pending`.
    let pending = null;
    const show = (index, behavior = 'smooth') => {
      const target = (index + slides.length) % slides.length;
      pending = target;
      markActive(target);
      track.scrollTo({ left: slides[target].offsetLeft, behavior });
    };
    const showMedia = (mediaId, behavior) => {
      const index = slides.findIndex((slide) => slide.dataset.mediaId === String(mediaId));
      if (index >= 0) show(index, behavior);
    };
    thumbs.forEach((thumb) => thumb.addEventListener('click', () => show(Number(thumb.dataset.ulThumb))));
    root.querySelectorAll('[data-ul-step]').forEach((button) =>
      button.addEventListener('click', () => show(active + Number(button.dataset.ulStep)))
    );
    let settle;
    track.addEventListener('scroll', () => {
      clearTimeout(settle);
      settle = setTimeout(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (pending !== null && index !== pending) return;
        pending = null;
        markActive(index);
      }, 100);
    });
    ['pointerdown', 'wheel', 'touchstart'].forEach((type) =>
      track.addEventListener(type, () => (pending = null), { passive: true })
    );
    field('zoom-open')?.addEventListener('click', () => {
      field('zoom-image').src = slides[active].dataset.zoom;
      dialog.showModal();
    });
    dialog.addEventListener('click', (event) => event.target === dialog && dialog.close());

    const selected = variants.find((item) => item.id === Number(field('variant-id').value));
    if (selected?.media) showMedia(selected.media, 'instant');
    else markActive(0);

    const selects = [...root.querySelectorAll('[data-ul-option]')];
    const update = () => {
      const chosen = selects.map((select) => select.value);
      const variant = variants.find((item) => item.options.every((value, index) => value === chosen[index]));
      const submit = field('submit');
      if (!variant) {
        submit.disabled = true;
        submit.textContent = 'Unavailable';
        field('stock').textContent = 'This combination is not offered';
        return;
      }
      field('variant-id').value = variant.id;
      field('price').textContent = variant.price;
      field('compare').hidden = !variant.compare;
      field('compare').textContent = variant.compare || '';
      field('sku').textContent = variant.sku;
      field('stock').textContent = variant.stock;
      submit.disabled = !variant.available;
      submit.textContent = variant.available ? 'Add to cart' : 'Sold out';
      if (variant.media) showMedia(variant.media);
      const url = new URL(location.href);
      url.searchParams.set('variant', variant.id);
      history.replaceState(null, '', url);
    };
    selects.forEach((select) => select.addEventListener('change', update));
  })();
</script>

{% stylesheet %}
  .ul-product { display: grid; gap: 32px 64px; padding-block: 32px 64px; }
  @media (min-width: 990px) { .ul-product { grid-template-columns: 1fr 1fr; } }
  .ul-gallery { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .ul-gallery__stage { position: relative; }
  .ul-gallery__slides { display: flex; margin: 0; padding: 0; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border: 1px solid rgb(var(--color-foreground-rgb) / 0.1); border-radius: 8px; }
  .ul-gallery__slides::-webkit-scrollbar { display: none; }
  .ul-gallery__slide { flex: 0 0 100%; aspect-ratio: 1; scroll-snap-align: start; background: #fff; }
  .ul-gallery__slide img, .ul-gallery__slide svg { width: 100%; height: 100%; object-fit: contain; }
  .ul-gallery__arrow, .ul-gallery__zoom-button { position: absolute; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.9); color: #121212; box-shadow: 0 1px 4px rgb(0 0 0 / 0.16); cursor: pointer; }
  .ul-gallery__arrow { top: 50%; translate: 0 -50%; font-size: 24px; line-height: 1; }
  .ul-gallery__arrow--prev { left: 8px; }
  .ul-gallery__arrow--next { right: 8px; }
  .ul-gallery__zoom-button { top: 8px; right: 8px; }
  .ul-gallery__thumbs { position: relative; display: flex; gap: 8px; margin: 0; padding: 0; list-style: none; overflow-x: auto; }
  .ul-gallery__thumb { display: block; width: 64px; height: 64px; padding: 0; border: 1px solid rgb(var(--color-foreground-rgb) / 0.1); border-radius: 4px; overflow: hidden; background: #fff; cursor: pointer; }
  .ul-gallery__thumb[aria-current="true"] { border-color: rgb(var(--color-foreground-rgb)); }
  .ul-gallery__thumb img { width: 100%; height: 100%; object-fit: contain; }
  @media (min-width: 750px) {
    .ul-gallery { grid-template-columns: 64px minmax(0, 1fr); gap: 16px; }
    .ul-gallery__thumbs { order: -1; flex-direction: column; height: 0; min-height: 100%; overflow: hidden auto; }
  }
  .ul-gallery__dialog { width: min(100vw - 32px, 1024px); max-height: calc(100vh - 32px); padding: 0; border: 0; border-radius: 8px; background: #fff; }
  .ul-gallery__dialog::backdrop { background: rgb(0 0 0 / 0.8); }
  .ul-gallery__dialog img { display: block; width: 100%; height: auto; }
  .ul-gallery__close { position: absolute; top: 8px; right: 8px; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 50%; background: rgb(255 255 255 / 0.9); color: #121212; font-size: 24px; line-height: 1; cursor: pointer; }
  .ul-product__title { margin: 0 0 8px; }
  .ul-product__vendor { margin: 0 0 16px; opacity: 0.7; }
  .ul-product__price { display: flex; gap: 8px; align-items: baseline; margin: 0 0 32px; font-size: 24px; }
  .ul-product__price s { font-size: 16px; opacity: 0.6; }
  .ul-product__options { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 16px; }
  .ul-field { display: flex; flex-direction: column; gap: 4px; }
  .ul-field__label { font-size: 14px; opacity: 0.7; }
  .ul-field select, .ul-field input { min-height: 48px; padding: 0 16px; font: inherit; border: 1px solid rgb(var(--color-foreground-rgb) / 0.3); border-radius: 8px; background: transparent; color: inherit; }
  .ul-field--qty input { width: 96px; }
  .ul-product__facts { display: flex; flex-wrap: wrap; gap: 16px 32px; margin: 0 0 32px; }
  .ul-product__facts dt { font-size: 14px; opacity: 0.7; }
  .ul-product__facts dd { margin: 0; }
  .ul-product__buy { display: flex; align-items: end; gap: 16px; }
  .ul-product__buy .button { flex: 1; min-height: 48px; }
  .ul-product__variants { margin-top: 32px; }
  .ul-product__variants summary { cursor: pointer; }
  .ul-product__variants table { width: 100%; margin-top: 16px; border-collapse: collapse; font-size: 14px; }
  .ul-product__variants th, .ul-product__variants td { padding: 8px; text-align: left; border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1); }
  .ul-product__description { margin-top: 32px; }
{% endstylesheet %}

{% schema %}
{
  "name": "UltraLove product",
  "settings": []
}
{% endschema %}
