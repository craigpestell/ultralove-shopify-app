{%- comment -%}
  Product grid for the lab storefront. Used by templates/collection.ultralove.json,
  e.g. /collections/all?view=ultralove, or /collections/all/ultralove-catalog-import?view=ultralove
  for UltraLove imports only. Cards open the product with the ultralove product template.
{%- endcomment -%}
{%- paginate collection.products by section.settings.per_page -%}
  <div class="ul-catalog page-width">
    <header class="ul-catalog__header">
      <h1 class="ul-catalog__title">{{ section.settings.heading | default: collection.title | escape }}</h1>
      <p class="ul-catalog__count">
        {{- paginate.items }} {{ paginate.items | pluralize: 'product', 'products' -}}
        {%- if current_tags %} tagged {{ current_tags | join: ', ' | escape }}{% endif -%}
      </p>
    </header>

    {%- if collection.products.size > 0 -%}
      <ul class="ul-catalog__grid" role="list">
        {%- for product in collection.products -%}
          {%- liquid
            assign url = product.url | within: collection | append: '?view=ultralove'
            assign image = product.featured_media.preview_image
            assign variant_count = product.variants.size
          -%}
          <li class="ul-card">
            <a class="ul-card__link" href="{{ url }}">
              <div class="ul-card__media">
                {%- if image -%}
                  {{ image | image_url: width: 512 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.title | escape }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'ul-card__placeholder' }}
                {%- endif -%}
                {%- unless product.available -%}
                  <span class="ul-badge ul-badge--muted">Sold out</span>
                {%- endunless -%}
              </div>
              <div class="ul-card__body">
                <h2 class="ul-card__title">{{ product.title | escape }}</h2>
                <p class="ul-card__price">
                  {%- if product.price_varies -%}From {% endif -%}
                  {{ product.price_min | money }}
                  {%- if product.compare_at_price_min > product.price_min %}
                    <s class="ul-card__compare">{{ product.compare_at_price_min | money }}</s>
                  {%- endif -%}
                </p>
                <p class="ul-card__meta">
                  {%- if product.has_only_default_variant -%}
                    {{ product.selected_or_first_available_variant.sku | default: 'Single item' | escape }}
                  {%- else -%}
                    {{ variant_count }} variants
                    {%- for option in product.options_with_values %} · {{ option.values.size }} {{ option.name | downcase | escape }}{% endfor -%}
                  {%- endif -%}
                </p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="ul-pagination" aria-label="Pages">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" rel="prev">Previous</a>
          {%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" rel="next">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="ul-empty">
        No products are published to the Online Store yet. Imports create drafts unless the import is set to Active and published.
      </p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .ul-catalog { padding-block: 32px 64px; }
  .ul-catalog__header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; margin-bottom: 32px; }
  .ul-catalog__title { margin: 0; }
  .ul-catalog__count { margin: 0; opacity: 0.7; }
  .ul-catalog__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 224px), 1fr)); gap: 32px 16px; margin: 0; padding: 0; list-style: none; }
  .ul-card__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .ul-card__media { position: relative; aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: rgba(var(--color-foreground, 18, 18, 18), 0.04); }
  .ul-card__media img, .ul-card__placeholder { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .ul-card__link:hover .ul-card__media img { transform: scale(1.04); }
  .ul-card__body { padding-top: 16px; }
  .ul-card__title { margin: 0 0 8px; font-size: 1.6rem; line-height: 1.3; }
  .ul-card__link:hover .ul-card__title, .ul-card__link:focus-visible .ul-card__title { text-decoration: underline; }
  .ul-card__price, .ul-card__meta { margin: 0; }
  .ul-card__compare { margin-left: 8px; opacity: 0.6; }
  .ul-card__meta { margin-top: 4px; font-size: 1.3rem; opacity: 0.7; }
  .ul-badge { position: absolute; top: 8px; left: 8px; padding: 4px 8px; border-radius: 16px; font-size: 1.2rem; background: rgb(var(--color-background, 255, 255, 255)); }
  .ul-badge--muted { opacity: 0.85; }
  .ul-pagination { display: flex; justify-content: center; align-items: center; gap: 32px; margin-top: 64px; }
  .ul-empty { padding: 32px; border: 1px dashed rgba(var(--color-foreground, 18, 18, 18), 0.3); border-radius: 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "UltraLove catalog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the collection title" },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
