{%- comment -%}
  Latest catalog import and inventory sync, read from the shop metafield
  ultralove.import_status (JSON) that the app's worker publishes about once a minute
  while there is news. Used by templates/page.import-status.json.
{%- endcomment -%}
{%- assign status = shop.metafields.ultralove.import_status.value -%}
<div class="ul-status section page-width-content">
  <header class="ul-status__header">
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if status -%}
      <p class="ul-muted">Updated {{ status.generatedAt | date: '%b %-d, %Y at %-I:%M %p %Z' }}</p>
    {%- endif -%}
  </header>

  {%- if status == blank -%}
    <p class="ul-empty">The app has not published import status yet. It does so once its worker is running on the lab server.</p>
  {%- else -%}
    {%- assign latest = status.latest -%}
    <section class="ul-status__block">
      <h2>Latest import</h2>
      {%- if latest == blank -%}
        <p class="ul-muted">No catalog import has run yet.</p>
      {%- else -%}
        <p class="ul-status__run">
          {%- render 'ultralove-status-badge', status: latest.status -%}
          <span>Started {{ latest.startedAt | date: '%b %-d, %Y at %-I:%M %p' }}</span>
          {%- if latest.finishedAt -%}
            <span>Finished {{ latest.finishedAt | date: '%b %-d, %Y at %-I:%M %p' }}</span>
          {%- endif -%}
        </p>
        {%- if latest.error -%}<p class="ul-status__error">{{ latest.error | escape }}</p>{%- endif -%}

        <table class="ul-table ul-table--numbers">
          <thead><tr><th></th><th>Total</th><th>Created</th><th>Updated</th><th>Failed</th><th>Pending</th></tr></thead>
          <tbody>
            {%- for row in (1..2) -%}
              {%- liquid
                if forloop.first
                  assign label = 'Products'
                  assign c = latest.products
                else
                  assign label = 'Variants'
                  assign c = latest.variants
                endif
              -%}
              <tr>
                <th scope="row">{{ label }}</th>
                <td>{{ c.total }}</td><td>{{ c.created }}</td><td>{{ c.updated }}</td>
                <td{% if c.failed > 0 %} class="ul-bad"{% endif %}>{{ c.failed }}</td><td>{{ c.pending }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        {%- if latest.issueCount > 0 -%}
          <h3>Errors ({{ latest.issueCount }})</h3>
          <ul class="ul-issues">
            {%- for issue in latest.issues -%}
              <li><strong>{{ issue.name | escape }}</strong> <span class="ul-muted">{{ issue.sku | escape }} · #{{ issue.supplierId }}</span><br>{{ issue.error | escape }}</li>
            {%- endfor -%}
          </ul>
          {%- if latest.issueCount > latest.issues.size -%}
            <p class="ul-muted">Showing {{ latest.issues.size }} of {{ latest.issueCount }}. The app's import screen lists them all.</p>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    </section>

    {%- assign inventory = status.inventory -%}
    <section class="ul-status__block">
      <h2>Inventory sync</h2>
      <dl class="ul-stats">
        <div><dt>Listed products</dt><dd>{{ inventory.listed }}</dd></div>
        <div><dt>Syncing</dt><dd>{{ inventory.enrolled }}</dd></div>
        <div><dt>Paused</dt><dd>{{ inventory.paused }}</dd></div>
        <div><dt>Not enrolled</dt><dd>{{ inventory.notEnrolled }}</dd></div>
        <div><dt>Last successful sync</dt><dd>{% if inventory.lastSuccessAt %}{{ inventory.lastSuccessAt | date: '%b %-d, %-I:%M %p' }}{% else %}Never{% endif %}</dd></div>
        <div><dt>Next sync due</dt><dd>{% if inventory.nextRunAt %}{{ inventory.nextRunAt | date: '%b %-d, %-I:%M %p' }}{% else %}—{% endif %}</dd></div>
      </dl>
      {%- if inventory.states.size > 0 -%}
        <p class="ul-status__states">
          {%- for state in inventory.states -%}
            {%- render 'ultralove-status-badge', status: state[0] -%} {{ state[1] }}
          {%- endfor -%}
        </p>
      {%- endif -%}
      {%- if inventory.issueCount > 0 -%}
        <h3>Needs attention ({{ inventory.issueCount }})</h3>
        <ul class="ul-issues">
          {%- for issue in inventory.issues -%}
            <li><strong>{{ issue.name | escape }}</strong> <span class="ul-muted">#{{ issue.supplierId }}</span><br>{{ issue.error | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </section>

    {%- if status.history.size > 1 -%}
      <section class="ul-status__block">
        <h2>Recent imports</h2>
        <table class="ul-table ul-table--numbers">
          <thead><tr><th>Started</th><th>Status</th><th>Products</th><th>Created</th><th>Updated</th><th>Failed</th></tr></thead>
          <tbody>
            {%- for run in status.history -%}
              <tr>
                <td>{{ run.startedAt | date: '%b %-d, %-I:%M %p' }}</td>
                <td>{% render 'ultralove-status-badge', status: run.status %}</td>
                <td>{{ run.total }}</td><td>{{ run.created }}</td><td>{{ run.updated }}</td>
                <td{% if run.failed > 0 %} class="ul-bad"{% endif %}>{{ run.failed }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .ul-status { padding-block: 32px 64px; }
  .ul-status__header { margin-bottom: 32px; }
  .ul-status__header h1 { margin: 0 0 8px; }
  .ul-status__block { margin-bottom: 64px; }
  .ul-status__block h2 { margin: 0 0 16px; }
  .ul-status__block h3 { margin: 32px 0 16px; }
  .ul-status__run, .ul-status__states { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 0 0 16px; }
  .ul-status__error { margin: 0 0 16px; color: #b3261e; }
  .ul-muted { margin: 0; opacity: 0.7; }
  .ul-bad { color: #b3261e; font-weight: 600; }
  .ul-table { width: 100%; border-collapse: collapse; }
  .ul-table th, .ul-table td { padding: 8px; text-align: left; border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.1); }
  .ul-table--numbers td { font-variant-numeric: tabular-nums; }
  .ul-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 192px), 1fr)); gap: 16px; margin: 0 0 16px; }
  .ul-stats div { padding: 16px; border-radius: 8px; background: rgb(var(--color-foreground-rgb) / 0.04); }
  .ul-stats dt { font-size: 14px; opacity: 0.7; }
  .ul-stats dd { margin: 4px 0 0; font-size: 24px; }
  .ul-issues { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .ul-issues li { padding: 16px; border-left: 4px solid #b3261e; border-radius: 4px; background: rgba(179, 38, 30, 0.06); }
  .ul-empty { padding: 32px; border: 1px dashed rgb(var(--color-foreground-rgb) / 0.3); border-radius: 8px; }
  .ul-pill { display: inline-block; padding: 4px 8px; border-radius: 16px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; background: rgb(var(--color-foreground-rgb) / 0.08); }
  .ul-pill--good { background: #dcefe0; color: #1e5b2c; }
  .ul-pill--bad { background: #f9dedc; color: #8c1d18; }
  .ul-pill--busy { background: #fdf0c8; color: #6b4f00; }
{% endstylesheet %}

{% schema %}
{
  "name": "UltraLove import status",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Catalog import status" }
  ]
}
{% endschema %}
